diff --git a/src/db/types/icon.rs b/src/db/types/icon.rs
--- a/src/db/types/icon.rs
+++ b/src/db/types/icon.rs
@@ -21,8 +21,29 @@

     /// The icon is a custom icon specified by a [CustomIconId]
     Custom(CustomIconId),
+
+    /// Both icon fields are present. Preserve the built-in ID alongside the custom icon.
+    BuiltInAndCustom(usize, CustomIconId),
 }

+impl Icon {
+    /// Get the built-in ID, if the entry or group specifies one.
+    pub fn built_in_id(&self) -> Option<usize> {
+        match self {
+            Self::BuiltIn(id) | Self::BuiltInAndCustom(id, _) => Some(*id),
+            Self::Custom(_) => None,
+        }
+    }
+
+    /// Get the custom icon ID, if the entry or group specifies one.
+    pub fn custom_id(&self) -> Option<CustomIconId> {
+        match self {
+            Self::Custom(id) | Self::BuiltInAndCustom(_, id) => Some(*id),
+            Self::BuiltIn(_) => None,
+        }
+    }
+}
+
 /// A unique identifier for a [CustomIcon]
 #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
 #[cfg_attr(feature = "serialization", derive(serde::Serialize))]
