 impl EntryTrack<'_> {
+    /// Stamp the edit. KeePassXC merges history by modification time and treats two versions
+    /// with the same time as one, so an edit in the same second as the version it replaces would
+    /// lose that version on the next merge. Step one second past it instead of using the clock.
+    fn touch(&mut self) {
+        let now = Times::now();
+        let previous = self
+            .history
+            .as_ref()
+            .and_then(|history| history.entries.last())
+            .and_then(|version| version.times.last_modification);
+        let stamp = match previous {
+            Some(previous) if now <= previous => previous
+                .checked_add_signed(chrono::TimeDelta::seconds(1))
+                .unwrap_or(previous),
+            _ => now,
+        };
+        self.times.last_modification = Some(stamp);
+    }
