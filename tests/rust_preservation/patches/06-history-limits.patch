+    /// Which versions stay under the limits, by index. A negative limit means no limit.
+    ///
+    /// KeePass and KeePassXC both keep the newest versions whose combined size fits, so one walk
+    /// covers both limits. Age comes from the modification time as in KeePass, not the list
+    /// position as in KeePassXC: files written by unpatched keepass-rs list the newest version
+    /// first, and going by position would delete exactly the versions worth keeping.
+    pub(crate) fn within_limits(
+        &self,
+        max_items: Option<isize>,
+        max_size: Option<isize>,
+        size: impl Fn(&Entry) -> u64,
+    ) -> Vec<bool> {
+        let max_items = max_items.and_then(|n| usize::try_from(n).ok()).unwrap_or(usize::MAX);
+        let max_size = max_size.and_then(|n| u64::try_from(n).ok()).unwrap_or(u64::MAX);
+
+        // Stable, so among equal times (second precision) the later position counts as newer.
+        let mut oldest_first: Vec<(usize, &Entry)> = self.entries.iter().enumerate().collect();
+        oldest_first.sort_by_key(|(_, version)| version.times.last_modification);
+
+        let mut keep = vec![false; self.entries.len()];
+        let mut total: u64 = 0;
+        for (index, version) in oldest_first.into_iter().rev().take(max_items) {
+            total = total.saturating_add(size(version));
+            if total > max_size {
+                break;
+            }
+            if let Some(slot) = keep.get_mut(index) {
+                *slot = true;
+            }
+        }
+        keep
+    }
