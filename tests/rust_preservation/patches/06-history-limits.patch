+    /// Bytes this version counts towards `HistoryMaxSize`, measured like KeePassXC's `Entry::size`.
+    /// KeePass estimates process memory instead, so it trims earlier; there is no common number.
+    fn history_size(&self, attachments: &HashMap<AttachmentId, Attachment>) -> u64 {
+        let fields = self.fields.iter().map(|(key, value)| key.len() + value.get().len());
+        let attachments = self.attachments.iter().map(|(name, id)| {
+            name.len() + attachments.get(id).map_or(0, |attachment| attachment.data.get().len())
+        });
+        let associations = self.autotype.iter().flat_map(|autotype| {
+            autotype.associations.iter().map(|a| a.window.len() + a.sequence.len())
+        });
+        let custom_data = self.custom_data.iter().map(|(key, item)| {
+            key.len()
+                + match &item.value {
+                    Some(CustomDataValue::String(value)) => value.len(),
+                    Some(CustomDataValue::Binary(value)) => value.len(),
+                    None => 0,
+                }
+        });
+        let tags = self.tags.iter().map(String::len);
+        fields
+            .chain(attachments)
+            .chain(associations)
+            .chain(custom_data)
+            .chain(tags)
+            .fold(0, |total: u64, size| total.saturating_add(size as u64))
+    }
+}
