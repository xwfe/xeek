+/// Keep only the marked history versions and bring back-references in line.
+///
+/// References store a position in the history, so every version after a dropped one moves. Content
+/// goes with its last reference, otherwise a deleted version's attachment would stay in the file;
+/// a pool item that was unreferenced before this call is left alone. Custom icons stay, as they do
+/// in KeePass and KeePassXC: they belong to the database and can be reused.
+fn retain_history(database: &mut Database, id: EntryId, keep: &[bool]) {
+    let Some(history) = database.entries.get_mut(&id).and_then(|entry| entry.history.as_mut()) else {
+        return;
+    };
+    let mut positions = HashMap::new();
+    for (index, version) in std::mem::take(&mut history.entries).into_iter().enumerate() {
+        if keep.get(index) == Some(&true) {
+            positions.insert(index, history.entries.len());
+            history.entries.push(version);
+        }
+    }
+
+    let renumber = |references: &mut HashSet<(EntryId, Option<usize>)>| {
+        let before = references.len();
+        *references = references
+            .drain()
+            .filter_map(|(entry, index)| match index {
+                Some(index) if entry == id => positions.get(&index).map(|&moved| (entry, Some(moved))),
+                _ => Some((entry, index)),
+            })
+            .collect();
+        references.len() < before
+    };
+    database
+        .attachments
+        .retain(|_, attachment| !renumber(&mut attachment.entries) || !attachment.entries.is_empty());
+    for icon in database.custom_icons.values_mut() {
+        renumber(&mut icon.entries);
+    }
 }
 
