+/// Drop the history versions over `HistoryMaxItems`/`HistoryMaxSize`, oldest first.
+fn trim_history(database: &mut Database, id: EntryId) {
+    let Some(history) = database.entries.get(&id).and_then(|entry| entry.history.as_ref()) else {
+        return;
+    };
+    let keep = history.within_limits(
+        database.meta.history_max_items,
+        database.meta.history_max_size,
+        |version| version.history_size(&database.attachments),
+    );
+    if keep.contains(&false) {
+        retain_history(database, id, &keep);
+    }
+}
