# 本机状态与工具缓存，不把执行日志或设备信息放进版本历史。
.DS_Store
._*
.gld/
.playwright-mcp/
__pycache__/
*.pyc
# K002 本地秘密扫描依赖和临时测试目录；规则、源码和哈希锁提交。
/tests/secret_scan/.deps/
/tests/secret_scan/.scratch/
/tests/secret_scan/.resolve.json
# K002 隔离测试依赖；源码、固定版本和校验锁文件仍保留。
/tests/kdbx_oracle/.venv/
/tests/kdbx_oracle/.venv-argon2/
/tests/kdbx_oracle/.deps-argon2/
# K071 项目内下载的测试浏览器；版本由 package.json 和 pnpm-lock.yaml 固定。
/tests/web_storage/.browsers/
# K003 kdbx.dart 候选的项目内 pub 缓存；pubspec.lock 提交。
/tests/dart_candidate/.pub-cache/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
target/
node_modules/
coverage/
Pods/
.symlinks/
DerivedData/
*.xcuserstate
xcuserdata/

# 凭据和密码库默认排除。后续合成测试样本须逐文件审查并明确放行。
.env
.env.*
!.env.example
!.env.sample
*.kdbx
*.keyx
*.key
*.pem
*.p12
*.pfx
*.passkey
*.ppk
id_rsa
id_ecdsa
id_ecdsa_sk
id_ed25519
id_ed25519_sk
id_dsa
*.jks
*.keystore
*.mobileprovision
android/local.properties
android/key.properties

# 原始Stitch设计、源码、依赖锁文件应保留；不全局忽略zip/png/lock。
# .gitignore不是秘密扫描或访问控制，不能阻止强制添加敏感文件。

